{
  "name": "udi-studio",
  "version": "0.2.0",
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/deepbule0/UDI.git" },
  "homepage": "https://deepbule0.github.io/UDI/",
  "bugs": { "url": "https://github.com/deepbule0/UDI/issues" },
  "description": "A reference prototype for portable, user-defined interfaces with local data bindings and reviewable revisions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "evaluate": "tsx scripts/evaluate.ts",
    "agent": "tsx scripts/agent.ts",
    "smoke:model": "tsx scripts/smoke-model.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "ajv": "8.20.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
