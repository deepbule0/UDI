{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:udi:spec:0.1",
  "title": "UDI Core 0.1 interface package",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "metadata", "capabilities", "sources", "views", "actions", "layout"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "version"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "layout": { "enum": ["balanced", "focus"] },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["experiments.read", "commits.read", "deadlines.read", "papers.read", "notes.write"] }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "entity", "capability"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "entity": { "enum": ["experiment", "commit", "deadline", "paper"] },
          "capability": { "enum": ["experiments.read", "commits.read", "deadlines.read", "papers.read"] }
        }
      }
    },
    "views": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "title", "source", "visible"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "type": { "enum": ["metrics", "table", "bar-chart", "timeline", "collection"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "source": { "$ref": "#/definitions/id" },
          "visible": { "type": "boolean" },
          "filter": { "enum": ["all", "failed"] },
          "groupBy": { "enum": ["none", "model"] },
          "highlightBelow": { "type": "number", "minimum": -10, "maximum": 0 }
        }
      }
    },
    "actions": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "capability", "handler"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "capability": { "const": "notes.write" },
          "handler": { "const": "create-review-note" }
        }
      }
    }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } }
}
